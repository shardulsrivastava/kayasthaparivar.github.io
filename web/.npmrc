# Enforce the exact npm version pinned in package.json's "engines" field.
# Without this, "engines" is just advisory and a mismatched npm can silently
# regenerate package-lock.json in a way a different npm version can't read
# (this has bitten CI's `npm ci` twice already - see git log). With this,
# a mismatched npm refuses to run at all instead of writing a bad lockfile.
engine-strict=true
